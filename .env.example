# Docker Compose host ports and service defaults.
APP_PORT=3000
NODE_IMAGE=node:22-bookworm-slim
PNPM_VERSION=10.32.1
MYSQL_IMAGE=mysql:8.4
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=zr_access_portal
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Local development database URL. Docker Compose overrides this inside the app container.
DATABASE_URL="mysql://root:password@localhost:3306/zr_access_portal"

# Comma separated. These accounts can access /admin and all /api/admin/** routes.
NUXT_ADMIN_ACCOUNTS="admin"

# Legacy compatibility for existing email-based admin users.
NUXT_ADMIN_EMAILS="admin@example.com"

# Linux.do Connect OAuth application config.
NUXT_LINUXDO_CLIENT_ID=""
NUXT_LINUXDO_CLIENT_SECRET=""
NUXT_LINUXDO_REDIRECT_URI="http://localhost:3000/api/auth/linuxdo/callback"
# Optional. Leave empty unless your Linux.do Connect application requires scopes.
NUXT_LINUXDO_SCOPE=""
# Optional endpoint overrides.
# NUXT_LINUXDO_AUTHORIZE_URL="https://connect.linux.do/oauth2/authorize"
# NUXT_LINUXDO_TOKEN_URL="https://connect.linux.do/oauth2/token"
# NUXT_LINUXDO_USER_URL="https://connect.linux.do/api/user"

# MinIO object storage for avatar and third-party file uploads.
NUXT_MINIO_ENDPOINT="localhost"
NUXT_MINIO_PORT="9000"
NUXT_MINIO_USE_SSL="false"
NUXT_MINIO_ACCESS_KEY="minioadmin"
NUXT_MINIO_SECRET_KEY="minioadmin"
NUXT_MINIO_BUCKET="zr-access-portal"
NUXT_MINIO_REGION="us-east-1"
NUXT_MINIO_PUBLIC_BASE_URL="http://localhost:9000/zr-access-portal"

NUXT_PUBLIC_APP_NAME="ZR-AI服务"
NUXT_PUBLIC_APP_URL="http://localhost:3000"
NUXT_PUBLIC_DEFAULT_CALLBACK_URL=""

# MySQL example:
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://root:password@localhost:33306/zr_access_portal"

# Comma separated. These users can access /admin and all /api/admin/** routes.
NUXT_ADMIN_EMAILS="admin@example.com"

# Linux.do Connect OAuth application config.
NUXT_LINUXDO_CLIENT_ID=""
NUXT_LINUXDO_CLIENT_SECRET=""
NUXT_LINUXDO_REDIRECT_URI="http://localhost:3000/api/auth/linuxdo/callback"
# Optional. Leave empty unless your Linux.do Connect application requires scopes.
NUXT_LINUXDO_SCOPE=""
# Optional endpoint overrides.
# NUXT_LINUXDO_AUTHORIZE_URL="https://connect.linux.do/oauth2/authorize"
# NUXT_LINUXDO_TOKEN_URL="https://connect.linux.do/oauth2/token"
# NUXT_LINUXDO_USER_URL="https://connect.linux.do/api/user"

NUXT_PUBLIC_APP_NAME="ZR-AI服务"
NUXT_PUBLIC_APP_URL="http://localhost:3000"
NUXT_PUBLIC_DEFAULT_CALLBACK_URL=""
